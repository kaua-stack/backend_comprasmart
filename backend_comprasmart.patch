+    return res.status(400).json({ error: "O e-mail é obrigatório" });
+  }
+
+  if (typeof user_password !== "string" || !user_password) {
+    return res.status(400).json({ error: "A senha é obrigatória" });
+  }
+
+  return next();
+}
