+
+const shoppingListRouter = express.Router();
+
+shoppingListRouter.use(authenticationToken);
+shoppingListRouter.post("/", shoppingListController.createList);
+shoppingListRouter.get("/", shoppingListController.getLists);
+shoppingListRouter.patch("/:listId", shoppingListController.archiveList);
+shoppingListRouter.get("/:listId/items", shoppingListController.getItems);
+shoppingListRouter.post("/:listId/items", shoppingListController.addItem);
+shoppingListRouter.patch("/:listId/items/:itemId", shoppingListController.updateItem);
+shoppingListRouter.delete("/:listId/items/:itemId", shoppingListController.deleteItem);
+
+export default shoppingListRouter;
