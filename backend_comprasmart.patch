@@ -0,0 +1,177 @@
+import pool from "../db/database.js";
+
+function normalizeListName(listName) {
+  const value = typeof listName === "string" ? listName.trim() : "";
+  return value || "Minha lista";
+}
+
+const shoppingListModel = {
+  async createList(userId, listName) {
+    const [result] = await pool.execute(
+      "INSERT INTO shopping_lists (user_id, list_name) VALUES (?, ?)",
+      [userId, normalizeListName(listName)],
+    );
+    return result;
+  },
+
+  async selectListsByUser(userId) {
+    const [rows] = await pool.execute(
+      `SELECT
+         sl.list_id,
+         sl.list_name,
+         sl.is_archived,
+         sl.created_at,
+         sl.updated_at,
+         COUNT(sli.item_id) AS item_count,
+         SUM(CASE WHEN sli.is_checked = 0 THEN 1 ELSE 0 END) AS pending_item_count
+       FROM shopping_lists sl
+       LEFT JOIN shopping_list_items sli ON sli.list_id = sl.list_id
+       WHERE sl.user_id = ?
+       GROUP BY sl.list_id, sl.list_name, sl.is_archived, sl.created_at, sl.updated_at
+       ORDER BY sl.is_archived ASC, sl.updated_at DESC`,
+      [userId],
+    );
+    return rows;
+  },
+
+  async selectListById(userId, listId) {
+    const [rows] = await pool.execute(
+      `SELECT list_id, user_id, list_name, is_archived, created_at, updated_at
+       FROM shopping_lists
+       WHERE list_id = ? AND user_id = ?
+       LIMIT 1`,
+      [listId, userId],
+    );
+    return rows[0] || null;
+  },
+
+  async selectItems(userId, listId) {
+    const [rows] = await pool.execute(
+      `SELECT
+         sli.item_id,
+         sli.list_id,
+         sli.product_id,
+         sli.comparison_key,
+         sli.product_name,
+         sli.source,
+         sli.external_id,
+         sli.quantity,
+         sli.unit,
+         sli.price_at_added,
+         sli.notes,
+         sli.is_checked,
+         sli.created_at,
+         sli.updated_at,
+         p.price,
+         p.promotional_price,
+         p.available,
+         p.image_url,
+         p.product_url
+       FROM shopping_list_items sli
+       INNER JOIN shopping_lists sl ON sl.list_id = sli.list_id
+       LEFT JOIN products p ON p.id = sli.product_id
+       WHERE sli.list_id = ? AND sl.user_id = ?
+       ORDER BY sli.is_checked ASC, sli.created_at DESC`,
+      [listId, userId],
+    );
+    return rows;
+  },
+
+  async selectProduct(productId) {
+    const [rows] = await pool.execute(
+      `SELECT id, source, external_id, name, price, promotional_price, unit, product_url
+       FROM products
+       WHERE id = ?
+       LIMIT 1`,
+      [productId],
+    );
+    return rows[0] || null;
+  },
+
+  async addItem(userId, listId, item) {
+    const list = await this.selectListById(userId, listId);
+    if (!list) return { error: "LIST_NOT_FOUND" };
+
+    let product = null;
+    if (item.product_id !== undefined && item.product_id !== null) {
+      product = await this.selectProduct(item.product_id);
+      if (!product) return { error: "PRODUCT_NOT_FOUND" };
+    }
+
+    const productName = item.product_name?.trim() || product?.name;
+    if (!productName) return { error: "PRODUCT_NAME_REQUIRED" };
+
+    const [result] = await pool.execute(
+      `INSERT INTO shopping_list_items
+        (list_id, product_id, comparison_key, product_name, source, external_id,
+         quantity, unit, price_at_added, notes)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      [
+        listId,
+        product?.id ?? item.product_id ?? null,
+        item.comparison_key?.trim() || null,
+        productName,
+        item.source?.trim() || product?.source || null,
+        item.external_id?.trim() || product?.external_id || null,
+        item.quantity ?? 1,
+        item.unit?.trim() || product?.unit || null,
+        item.price_at_added ?? product?.promotional_price ?? product?.price ?? null,
+        item.notes?.trim() || null,
+      ],
+    );
+
+    return { result, list };
+  },
+
+  async updateItem(userId, listId, itemId, changes) {
+    const fields = [];
+    const values = [];
+
+    if (changes.quantity !== undefined) {
+      fields.push("quantity = ?");
+      values.push(changes.quantity);
+    }
+    if (changes.notes !== undefined) {
+      fields.push("notes = ?");
+      values.push(changes.notes?.trim() || null);
+    }
+    if (changes.is_checked !== undefined) {
+      fields.push("is_checked = ?");
+      values.push(changes.is_checked ? 1 : 0);
+    }
+
+    if (fields.length === 0) return { affectedRows: 0 };
+
+    values.push(itemId, listId, userId);
+    const [result] = await pool.execute(
+      `UPDATE shopping_list_items sli
+       INNER JOIN shopping_lists sl ON sl.list_id = sli.list_id
+       SET ${fields.join(", ")}
+       WHERE sli.item_id = ? AND sli.list_id = ? AND sl.user_id = ?`,
+      values,
+    );
+    return result;
+  },
+
+  async deleteItem(userId, listId, itemId) {
+    const [result] = await pool.execute(
+      `DELETE sli FROM shopping_list_items sli
+       INNER JOIN shopping_lists sl ON sl.list_id = sli.list_id
+       WHERE sli.item_id = ? AND sli.list_id = ? AND sl.user_id = ?`,
+      [itemId, listId, userId],
+    );
+    return result;
+  },
+
+  async archiveList(userId, listId, isArchived = true) {
+    const [result] = await pool.execute(
+      `UPDATE shopping_lists
+       SET is_archived = ?
+       WHERE list_id = ? AND user_id = ?`,
+      [isArchived ? 1 : 0, listId, userId],
+    );
+    return result;
+  },
+};
+
+export default shoppingListModel;
