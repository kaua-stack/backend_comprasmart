@@ -0,0 +1,145 @@
+import shoppingListModel from "../models/ShoppingListModel.js";
+
+function userIdFromRequest(req) {
+  return Number(req.user?.id);
+}
+
+function validId(value) {
+  const id = Number(value);
+  return Number.isSafeInteger(id) && id > 0 ? id : null;
+}
+
+class ShoppingListController {
+  async createList(req, res) {
+    const userId = userIdFromRequest(req);
+    const listName = req.body?.list_name;
+
+    if (!Number.isSafeInteger(userId) || (listName !== undefined && typeof listName !== "string")) {
+      return res.status(400).json({ error: "Nome da lista inválido" });
+    }
+
+    try {
+      const result = await shoppingListModel.createList(userId, listName);
+      return res.status(201).json({
+        list_id: result.insertId,
+        list_name: typeof listName === "string" && listName.trim() ? listName.trim() : "Minha lista",
+      });
+    } catch (error) {
+      if (error.code === "ER_DUP_ENTRY") {
+        return res.status(409).json({ error: "Você já possui uma lista com esse nome" });
+      }
+
+      console.error("Erro ao criar lista:", error);
+      return res.status(500).json({ error: "Erro ao criar lista" });
+    }
+  }
+
+  async getLists(req, res) {
+    try {
+      const lists = await shoppingListModel.selectListsByUser(userIdFromRequest(req));
+      return res.status(200).json(lists);
+    } catch (error) {
+      console.error("Erro ao buscar listas:", error);
+      return res.status(500).json({ error: "Erro ao buscar listas" });
+    }
+  }
+
+  async getItems(req, res) {
+    const listId = validId(req.params.listId);
+    if (!listId) return res.status(400).json({ error: "ID da lista inválido" });
+
+    try {
+      const list = await shoppingListModel.selectListById(userIdFromRequest(req), listId);
+      if (!list) return res.status(404).json({ error: "Lista não encontrada" });
+
+      const items = await shoppingListModel.selectItems(userIdFromRequest(req), listId);
+      return res.status(200).json({ list, items });
+    } catch (error) {
+      console.error("Erro ao buscar itens da lista:", error);
+      return res.status(500).json({ error: "Erro ao buscar itens da lista" });
+    }
+  }
+
+  async addItem(req, res) {
+    const listId = validId(req.params.listId);
+    const body = req.body && typeof req.body === "object" ? req.body : {};
+
+    if (!listId) return res.status(400).json({ error: "ID da lista inválido" });
+    if (body.quantity !== undefined && (!Number.isFinite(Number(body.quantity)) || Number(body.quantity) <= 0)) {
+      return res.status(400).json({ error: "A quantidade deve ser maior que zero" });
+    }
+
+    try {
+      const result = await shoppingListModel.addItem(userIdFromRequest(req), listId, body);
+      if (result.error === "LIST_NOT_FOUND") return res.status(404).json({ error: "Lista não encontrada" });
+      if (result.error === "PRODUCT_NOT_FOUND") return res.status(404).json({ error: "Produto não encontrado" });
+      if (result.error === "PRODUCT_NAME_REQUIRED") return res.status(400).json({ error: "Informe product_id ou product_name" });
+
+      return res.status(201).json({ item_id: result.result.insertId });
+    } catch (error) {
+      console.error("Erro ao adicionar item:", error);
+      return res.status(500).json({ error: "Erro ao adicionar item na lista" });
+    }
+  }
+
+  async updateItem(req, res) {
+    const listId = validId(req.params.listId);
+    const itemId = validId(req.params.itemId);
+
+    if (!listId || !itemId) return res.status(400).json({ error: "ID da lista ou do item inválido" });
+
+    try {
+      const result = await shoppingListModel.updateItem(
+        userIdFromRequest(req),
+        listId,
+        itemId,
+        req.body && typeof req.body === "object" ? req.body : {},
+      );
+
+      if (result.affectedRows !== 1) {
+        return res.status(404).json({ error: "Item não encontrado ou nenhuma alteração foi feita" });
+      }
+
+      return res.status(200).json({ success: "Item atualizado" });
+    } catch (error) {
+      console.error("Erro ao atualizar item:", error);
+      return res.status(500).json({ error: "Erro ao atualizar item" });
+    }
+  }
+
+  async deleteItem(req, res) {
+    const listId = validId(req.params.listId);
+    const itemId = validId(req.params.itemId);
+
+    if (!listId || !itemId) return res.status(400).json({ error: "ID da lista ou do item inválido" });
+
+    try {
+      const result = await shoppingListModel.deleteItem(userIdFromRequest(req), listId, itemId);
+      if (result.affectedRows !== 1) return res.status(404).json({ error: "Item não encontrado" });
+      return res.status(200).json({ success: "Item removido da lista" });
+    } catch (error) {
+      console.error("Erro ao remover item:", error);
+      return res.status(500).json({ error: "Erro ao remover item" });
+    }
+  }
+
+  async archiveList(req, res) {
+    const listId = validId(req.params.listId);
+    if (!listId) return res.status(400).json({ error: "ID da lista inválido" });
+
+    try {
+      const result = await shoppingListModel.archiveList(
+        userIdFromRequest(req),
+        listId,
+        req.body?.is_archived !== false,
+      );
+      if (result.affectedRows !== 1) return res.status(404).json({ error: "Lista não encontrada" });
+      return res.status(200).json({ success: "Lista atualizada" });
+    } catch (error) {
+      console.error("Erro ao arquivar lista:", error);
+      return res.status(500).json({ error: "Erro ao atualizar lista" });
+    }
+  }
+}
+
+export default new ShoppingListController();
