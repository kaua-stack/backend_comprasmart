@@ -0,0 +1,26 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+const schema = await readFile(new URL("../sql/mercado_scraper.sql", import.meta.url), "utf8");
+
+test("schema cria banco e entidades essenciais", () => {
+  for (const table of [
+    "roles",
+    "users",
+    "tokens",
+    "products",
+    "shopping_lists",
+    "shopping_list_items",
+  ]) {
+    assert.match(schema, new RegExp(`CREATE TABLE IF NOT EXISTS ${table}\\b`));
+  }
+
+  assert.match(schema, /CREATE DATABASE IF NOT EXISTS mercado_scraper/);
+  assert.match(schema, /FOREIGN KEY \(role_id\) REFERENCES roles/);
+  assert.match(schema, /FOREIGN KEY \(user_id\) REFERENCES users/);
+  assert.match(schema, /FOREIGN KEY \(list_id\) REFERENCES shopping_lists/);
+  assert.match(schema, /FOREIGN KEY \(product_id\) REFERENCES products/);
+  assert.match(schema, /uq_source_product_url/);
+  assert.match(schema, /comparison_key VARCHAR\(255\)/);
+});
