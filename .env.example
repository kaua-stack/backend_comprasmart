NODE_ENV=development
PORT_SERVER=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=comprasmart_app
DB_PASSWORD=troque-esta-senha
DB_NAME=comprasmart

# Banco do mercado_scraper. Se ficar no mesmo MySQL, DB_* pode ser reutilizado.
MARKET_DB_HOST=127.0.0.1
MARKET_DB_PORT=3306
MARKET_DB_USER=mercado_scraper_app
MARKET_DB_PASSWORD=troque-esta-senha
MARKET_DB_NAME=mercado_scraper
MARKET_DB_CONNECTION_LIMIT=5

ACCESS_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio
REFRESH_TOKEN_SECRET=troque-por-outro-segredo-longo-e-aleatorio

# Frontend separado: informe as origens exatas, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Opcional: necessário apenas para o login com Google.
GOOGLE_CLIENT_ID=
